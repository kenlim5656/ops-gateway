# ============================================================
# Ops Gateway - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- PostgreSQL (shared by Langfuse + LiteLLM) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-postgres-password
POSTGRES_DB=opsgateway

# --- Langfuse ---
LANGFUSE_SECRET_KEY=sk-lf-secret-changeme
LANGFUSE_PUBLIC_KEY=pk-lf-public-changeme
LANGFUSE_SALT=changeme-random-salt-value
NEXTAUTH_SECRET=changeme-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# Langfuse init credentials (first login)
LANGFUSE_INIT_USER_EMAIL=admin@ops-gateway.local
LANGFUSE_INIT_USER_PASSWORD=changeme-admin-password
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_ORG_NAME=Ops Gateway
LANGFUSE_INIT_PROJECT_NAME=Default Project

# --- LiteLLM ---
LITELLM_MASTER_KEY=sk-master-key-1234
LITELLM_SALT_KEY=changeme-litellm-salt

# --- AI Provider Keys ---
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# --- ClickHouse (Langfuse analytics) ---
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=changeme-clickhouse-password
